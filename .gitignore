# Cargo缓存
/target/
/target-*/
# CUDA 验证临时目录
.cargo-tmp-cuda/

# 本地数据库文件
# 注意: 不用前导斜杠——运行时数据目录可能出现在任意 crate 下
# （如 crates/ramaria-desktop/.ramaria-dev/，tauri dev 运行时创建），
# 前导 / 会把模式锚定在仓库根目录导致子目录不被忽略。
# 目录名以点开头（.ramaria-dev），模式必须包含该点。
.ramaria-dev/
/data/
*.db
*.sqlite
*.sqlite3

# 导出数据
/exports/

# 环境与隐私配置
.env
.env.*
!.env.example
*.key

# 日志文件
*.log
/logs/

# 系统与编译器文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.codebuddy/
.reasonix/
.codegraph/

# 开发数据库（本地数据，不上传）
*.db-journal
*.db-wal
*.db-shm

# 探针实验产物（probe build/run/evaluate/report 测试数据；含对话回复与评分，不上传）
/probe-*.json
/run-*.json
/eval-*.json
/report-*.json
/report-*.md
/calib-*.json
/probe-*.log
/run-*.log
/eval-*.log

# 探针实验数据归档目录（原根目录 probe/run/eval-*.json 收拢于此，规则随目录一并迁移）
/test-data/

# 项目私有文档（开发、设计、决策）
/docs/dev/
/docs/dev-1.0/
/docs/dev-1.1/
/docs/dev-1.2/
/docs/dev-1.3/
/docs/reports/