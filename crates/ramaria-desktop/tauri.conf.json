{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/crates/tauri-config-schema/schema.json",
  "productName": "Ramaria",
  "version": "1.7.0",
  "identifier": "com.ramaria.app",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ramaria - 个人AI陪伴记忆系统",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://api.deepseek.com https://api.openai.com; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../../config/personas/*.toml"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Ramaria",
    "shortDescription": "个人AI陪伴记忆系统",
    "longDescription": "Ramaria（珊瑚菌）是一个本地运行的个人AI陪伴记忆系统。具备分层记忆体系（L0-L3）、自动人格画像推断、混合RAG检索能力。支持LM Studio本地模型和DeepSeek/OpenAI云端API。",
    "category": "Utility",
    "licenseFile": "../../LICENSE"
  },
  "plugins": {
    "dialog": null,
    "notification": null,
    "store": null
  }
}
